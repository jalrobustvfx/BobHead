# Configure these as PRIVATE environment variables on the web host.
# This file is a reference; the app does not automatically read .env files.
BOBHEAD_BACKEND=comfy-api
BOBHEAD_HOST=0.0.0.0
PORT=8787
BOBHEAD_PUBLIC_ORIGIN=https://YOUR-WEB-HOST.example
COMFY_BASE_URL=https://YOUR-DEPLOYMENT.run.comfy.app
COMFY_API_KEY=
BOBHEAD_DEMO_PASSWORD=
BOBHEAD_SESSION_SECRET=
BOBHEAD_DATA_DIR=/data
BOBHEAD_MAX_JOBS_PER_DAY=10

# Opt-in passwordless public access; keeps visitor isolation and global job limits.
BOBHEAD_PUBLIC_DEMO=false
